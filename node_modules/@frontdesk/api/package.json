{
  "name": "@frontdesk/api",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/db', { recursive: true }); require('fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:stub": "tsx src/db/seed-stub.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@fastify/cors": "^9.0.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/jwt": "^9.0.4",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^7.0.4",
    "@frontdesk/shared": "*",
    "@frontdesk/sla": "*",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
