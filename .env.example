# ==============================================================================
# FRONTDESK - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (PostgreSQL 14+)
# When omitted, Frontdesk automatically falls back to embedded PGlite WASM database
DATABASE_URL=postgres://user:password@hostname:5432/frontdesk?sslmode=require

# Authentication & Session Secrets (Minimum 32 characters)
JWT_SECRET=frontdesk-jwt-production-secret-key-32-chars-min
COOKIE_SECRET=frontdesk-cookie-production-secret-key-32-chars

# Auto-migration & Database Seeding on Deploy
AUTO_MIGRATE=true
AUTO_SEED=true

# Free-Tier Keep-Alive Configuration (Render, Koyeb, Railway)
# Setting this to your deployed URL (e.g. https://frontdesk.onrender.com/api/health)
# will self-ping every 10 minutes to prevent container sleeping.
KEEP_ALIVE_URL=https://frontdesk.onrender.com/api/health
KEEP_ALIVE_INTERVAL_MINUTES=10
